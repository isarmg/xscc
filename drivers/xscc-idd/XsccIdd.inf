; XSCC-owned indirect display driver; no monitor is created by installation.
[Version]
Signature="$Windows NT$"
Class=Display
ClassGUID={4D36E968-E325-11CE-BFC1-08002BE10318}
ClassVer=2.0
Provider=%ManufacturerName%
CatalogFile=XsccIdd.cat
DriverVer=11/07/2026,0.1.0.0
PnpLockdown=1

[Manufacturer]
%ManufacturerName%=XSCC,NTamd64.10.0...22000

[XSCC.NTamd64.10.0...22000]
%DeviceName%=XsccIdd_Install,Root\XsccIdd

[SourceDisksNames]
1=%DiskName%

[SourceDisksFiles]
XsccIdd.dll=1

[DestinationDirs]
XsccIdd_Copy=13

[XsccIdd_Install.NT]
Include=WUDFRD.inf
Needs=WUDFRD.NT
CopyFiles=XsccIdd_Copy

[XsccIdd_Install.NT.hw]
Include=WUDFRD.inf
Needs=WUDFRD.NT.HW
AddReg=XsccIdd_DeviceSettings

[XsccIdd_DeviceSettings]
HKR,,"UpperFilters",0x00010000,"IndirectKmd"
HKR,"WUDF","DeviceGroupId",0x00000000,"{E50B8DAD-043F-4D9F-AC78-049931951779}"
HKR,,"Security",0x00000000,"D:P(A;;GA;;;SY)(A;;GA;;;BA)"

[XsccIdd_Install.NT.Services]
Include=WUDFRD.inf
Needs=WUDFRD.NT.Services

[XsccIdd_Install.NT.Wdf]
UmdfService=XsccIdd,XsccIdd_Service
UmdfServiceOrder=XsccIdd
UmdfKernelModeClientPolicy=AllowKernelModeClients
UmdfHostProcessSharing=ProcessSharingDisabled

[XsccIdd_Service]
UmdfLibraryVersion=$UMDFVERSION$
ServiceBinary=%13%\XsccIdd.dll
UmdfExtensions=IddCx0102

[XsccIdd_Copy]
XsccIdd.dll

[Strings]
ManufacturerName="XSCC"
DeviceName="XSCC Virtual Display"
DiskName="XSCC Virtual Display Driver"
