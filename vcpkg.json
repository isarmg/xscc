{
  "dependencies": [
    "aom",
    {
      "name": "cpu-features",
      "platform": "android"
    },
    {
      "name": "libsodium",
      "platform": "windows & arm64"
    },
    "opus",
    "libvpx",
    "libyuv"
  ],
  "vcpkg-configuration": {
    "default-registry": null,
    "overlay-ports": [
      "./res/vcpkg"
    ],
    "overlay-triplets": [
      "./res/vcpkg-triplets"
    ]
  },
  "default-features": [
    "hardware-video"
  ],
  "features": {
    "hardware-video": {
      "description": "FFmpeg hardware adapters and H.264/HEVC media support for desktop",
      "dependencies": [
        {
          "name": "ffmpeg",
          "features": [
            {
              "name": "amf",
              "platform": "(windows & !arm) | linux"
            },
            {
              "name": "nvcodec",
              "platform": "(windows & !arm) | linux"
            },
            {
              "name": "qsv",
              "platform": "windows & !arm"
            }
          ],
          "platform": "(windows | osx | (linux & !arm32)) & static"
        }
      ]
    }
  }
}
