--- a/libavcodec/amfenc.c
+++ b/libavcodec/amfenc.c
@@ -715,6 +715,22 @@
 
     if (!ctx->encoder)
         return AVERROR(EINVAL);
+
+    // Retirement switches a live synchronous encoder to nonblocking polling.
+    // Updating the AVOption alone would leave the AMF component's old timeout.
+    if (ctx->query_timeout == 0 && !ctx->query_timeout_nonblocking_applied) {
+        AMF_RESULT timeout_res = AMF_OK;
+        if (avctx->codec_id == AV_CODEC_ID_H264) {
+            AMF_ASSIGN_PROPERTY_INT64(timeout_res, ctx->encoder, AMF_VIDEO_ENCODER_QUERY_TIMEOUT, 0);
+        } else if (avctx->codec_id == AV_CODEC_ID_HEVC) {
+            AMF_ASSIGN_PROPERTY_INT64(timeout_res, ctx->encoder, AMF_VIDEO_ENCODER_HEVC_QUERY_TIMEOUT, 0);
+        } else if (avctx->codec_id == AV_CODEC_ID_AV1) {
+            AMF_ASSIGN_PROPERTY_INT64(timeout_res, ctx->encoder, AMF_VIDEO_ENCODER_AV1_QUERY_TIMEOUT, 0);
+        }
+        AMF_RETURN_IF_FALSE(ctx, timeout_res == AMF_OK, AVERROR_EXTERNAL,
+                            "AMF nonblocking query timeout failed: %d\n", timeout_res);
+        ctx->query_timeout_nonblocking_applied = 1;
+    }
 
     if (!frame->buf[0]) {
         ret = ff_encode_get_frame(avctx, frame);
