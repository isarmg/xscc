+#ifndef AVCODEC_AMFENC_FRAME_REF_H
+#define AVCODEC_AMFENC_FRAME_REF_H
+
+#include <stdatomic.h>
+#include <string.h>
+
+#include <AMF/core/Interface.h>
+#include "libavutil/frame.h"
+#include "libavutil/mem.h"
+
+#define AMF_FRAME_OWNER_PROPERTY L"av_frame_owner"
+
+static const AMFGuid amf_frame_owner_iid = {
+    0x8a4b7d20, 0xb6a8, 0x48e0, 0x91, 0x75, 0x9e, 0xd4, 0x30, 0x4f, 0x63, 0x13
+};
+
+typedef struct AmfFrameOwner {
+    AMFInterface iface;
+    atomic_int references;
+    AVFrame *frame;
+} AmfFrameOwner;
+
+static void amf_frame_owner_release_frame(AMFInterface *iface)
+{
+    AmfFrameOwner *owner = (AmfFrameOwner *)iface;
+    av_frame_free(&owner->frame);
+}
+
+static amf_long AMF_STD_CALL amf_frame_owner_acquire(AMFInterface *iface)
+{
+    AmfFrameOwner *owner = (AmfFrameOwner *)iface;
+    return (amf_long)atomic_fetch_add_explicit(&owner->references, 1, memory_order_relaxed) + 1;
+}
+
+static amf_long AMF_STD_CALL amf_frame_owner_release(AMFInterface *iface)
+{
+    AmfFrameOwner *owner = (AmfFrameOwner *)iface;
+    amf_long remaining = (amf_long)atomic_fetch_sub_explicit(&owner->references, 1, memory_order_acq_rel) - 1;
+    if (!remaining) {
+        amf_frame_owner_release_frame(iface);
+        av_free(owner);
+    }
+    return remaining;
+}
+
+static AMF_RESULT AMF_STD_CALL amf_frame_owner_query(AMFInterface *iface,
+                                                  const AMFGuid *iid, void **result)
+{
+    AMFGuid base_iid = IID_AMFInterface();
+    if (!result || !iid)
+        return AMF_INVALID_POINTER;
+    *result = NULL;
+    if (memcmp(iid, &base_iid, sizeof(*iid)) && memcmp(iid, &amf_frame_owner_iid, sizeof(*iid)))
+        return AMF_NO_INTERFACE;
+    iface->pVtbl->Acquire(iface);
+    *result = iface;
+    return AMF_OK;
+}
+
+static const AMFInterfaceVtbl amf_frame_owner_vtable = {
+    .Acquire = amf_frame_owner_acquire,
+    .Release = amf_frame_owner_release,
+    .QueryInterface = amf_frame_owner_query,
+};
+
+static AMFInterface *amf_frame_owner_create(const AVFrame *frame)
+{
+    AmfFrameOwner *owner = av_mallocz(sizeof(*owner));
+    if (!owner)
+        return NULL;
+    owner->frame = av_frame_clone(frame);
+    if (!owner->frame) {
+        av_free(owner);
+        return NULL;
+    }
+    owner->iface.pVtbl = &amf_frame_owner_vtable;
+    atomic_init(&owner->references, 1);
+    return &owner->iface;
+}
+
+#endif
