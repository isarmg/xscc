+// Interface properties release their payload even when AMF discards queued output.
+static AMF_RESULT amf_attach_frame_owner(AMFSurface *surface, const AVFrame *frame)
+{
+    AMFInterface *owner = amf_frame_owner_create(frame);
+    AMFVariantStruct value = {0};
+    AMF_RESULT res;
+    if (!owner)
+        return AMF_OUT_OF_MEMORY;
+    res = AMFVariantAssignInterface(&value, owner);
+    if (res == AMF_OK)
+        res = surface->pVtbl->SetProperty(surface, AMF_FRAME_OWNER_PROPERTY, value);
+    AMFVariantClear(&value);
+    owner->pVtbl->Release(owner);
+    return res;
+}
+
+static AMF_RESULT amf_release_frame_owner(AMFData *data)
+{
+    AMFVariantStruct value = {0};
+    AMFInterface *owner = NULL;
+    AMF_RESULT res = data->pVtbl->GetProperty(data, AMF_FRAME_OWNER_PROPERTY, &value);
+    if (res == AMF_OK) {
+        if (value.type != AMF_VARIANT_INTERFACE || !AMFVariantInterface(&value)) {
+            res = AMF_INVALID_DATA_TYPE;
+        } else {
+            AMFInterface *iface = AMFVariantInterface(&value);
+            res = iface->pVtbl->QueryInterface(iface, &amf_frame_owner_iid, (void **)&owner);
+            if (res == AMF_OK) {
+                // This local strong reference excludes final Release during pool return.
+                amf_frame_owner_release_frame(owner);
+                owner->pVtbl->Release(owner);
+            }
+        }
+    }
+    AMFVariantClear(&value);
+    return res;
+}
