@@ -0,0 +1,28 @@
+#ifndef AVCODEC_AMFENC_KEYFRAME_H
+#define AVCODEC_AMFENC_KEYFRAME_H
+
+// Called on the encoder owner thread before SubmitInput. These are properties
+// of this input surface, not a persistent encoder setting or an output key flag.
+static AMF_RESULT amf_surface_force_idr(AMFSurface *surface, int hevc, int force_idr)
+{
+    AMF_RESULT res = AMF_OK;
+    if (hevc) {
+        AMF_ASSIGN_PROPERTY_INT64(res, surface, AMF_VIDEO_ENCODER_HEVC_FORCE_PICTURE_TYPE,
+                                  force_idr ? AMF_VIDEO_ENCODER_HEVC_PICTURE_TYPE_IDR : AMF_VIDEO_ENCODER_HEVC_PICTURE_TYPE_NONE);
+        if (res != AMF_OK)
+            return res;
+        AMF_ASSIGN_PROPERTY_BOOL(res, surface, AMF_VIDEO_ENCODER_HEVC_INSERT_HEADER, force_idr);
+    } else {
+        AMF_ASSIGN_PROPERTY_INT64(res, surface, AMF_VIDEO_ENCODER_FORCE_PICTURE_TYPE,
+                                  force_idr ? AMF_VIDEO_ENCODER_PICTURE_TYPE_IDR : AMF_VIDEO_ENCODER_PICTURE_TYPE_NONE);
+        if (res != AMF_OK)
+            return res;
+        AMF_ASSIGN_PROPERTY_BOOL(res, surface, AMF_VIDEO_ENCODER_INSERT_SPS, force_idr);
+        if (res != AMF_OK)
+            return res;
+        AMF_ASSIGN_PROPERTY_BOOL(res, surface, AMF_VIDEO_ENCODER_INSERT_PPS, force_idr);
+    }
+    return res;
+}
+
+#endif
