<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package UpgradeCode="A0D593E5-31A3-4675-9821-BE03D92AD465" Name="xscc" Manufacturer="sarmg" Version="$(var.ProductVersion)" Scope="perMachine" InstallerVersion="500">
    <MajorUpgrade AllowSameVersionUpgrades="yes" DowngradeErrorMessage="A newer xscc is installed." Schedule="afterInstallInitialize" />
    <MediaTemplate EmbedCab="yes" />
    <Property Id="WINDOWSBUILD"><RegistrySearch Id="WindowsBuild" Root="HKLM" Key="SOFTWARE\Microsoft\Windows NT\CurrentVersion" Name="CurrentBuildNumber" Type="raw" Bitness="always64" /></Property>
    <Launch Condition="Installed OR (VersionNT64 AND WINDOWSBUILD &gt;= 22000)" Message="xscc requires Windows 11 x64 (build 22000) or newer." />
    <Property Id="EXISTINGCLIENTSERVICE"><RegistrySearch Id="ExistingService" Root="HKLM" Key="SYSTEM\CurrentControlSet\Services\Xscc" Name="ImagePath" Type="raw" Bitness="always64" /></Property>
    <Launch Condition="Installed OR WIX_UPGRADE_DETECTED OR NOT EXISTINGCLIENTSERVICE" Message="An unmanaged Xscc service already exists. Remove or rename that service before installing." />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/isarmg/xscc" />
    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />
    <WixVariable Id="WixUILicenseRtf" Value="$(var.LicenseRtf)" />
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="Xscc">
        <Component Id="ClientService" Guid="4C3D6380-EB5B-45B8-B9F7-77B28CD14E82" Bitness="always64">
          <File Id="ClientExe" Source="$(var.ClientExe)" Name="xscc.exe" KeyPath="yes" />
          <Environment Id="XsccMachinePath" Name="PATH" Value="[INSTALLFOLDER]" Action="set" Part="last" Permanent="no" System="yes" />
          <RegistryValue Root="HKLM" Key="Software\sarmg\xscc" Name="InstallLocation" Type="string" Value="[INSTALLFOLDER]" />
          <ServiceInstall Id="ServiceInstall" Name="Xscc" DisplayName="xscc" Description="Sunshine management only; configure with xscc setup." Type="ownProcess" Start="auto" ErrorControl="normal" Arguments="--windows-service --config &quot;[CommonAppDataFolder]Xscc&quot;" />
          <!-- Register native boot startup by default. Local setup pairs and starts the service. -->
          <ServiceControl Id="ServiceControl" Name="Xscc" Stop="both" Remove="uninstall" Wait="yes" />
        </Component>
        <?if $(var.IncludeInventory) = 1 ?>
        <Directory Id="ReleaseInventoryDirectory" Name="share" />
        <?endif?>
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="CommonAppDataFolder">
      <Directory Id="XsccStateDirectory" Name="Xscc">
        <Component Id="PreserveConfigurationSelection" Guid="F124AD7F-A435-4C44-A181-C7FE26DC0268" Bitness="always64">
          <RegistryValue Root="HKLM" Key="Software\sarmg\xscc" Name="PreserveConfiguration" Type="integer" Value="1" KeyPath="yes" />
        </Component>
        <Component Id="PreserveDataSelection" Guid="1AC45A4E-B558-47F6-96D4-5CA0BA55F90B" Bitness="always64">
          <RegistryValue Root="HKLM" Key="Software\sarmg\xscc" Name="PreserveData" Type="integer" Value="1" KeyPath="yes" />
        </Component>
        <Component Id="PrepareSetupSelection" Guid="8AB18773-F311-4D05-982B-78472DB87CC5" Bitness="always64">
          <RegistryValue Root="HKLM" Key="Software\sarmg\xscc" Name="PrepareSetup" Type="integer" Value="1" KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />
    <Feature Id="Complete" Title="xscc program" Description="Install xscc client program and service." Level="1" AllowAbsent="no" Display="expand">
      <ComponentRef Id="ClientService" />
      <?if $(var.IncludeInventory) = 1 ?>
      <ComponentGroupRef Id="ReleaseInventoryFiles" />
      <?endif?>
      <ComponentRef Id="PreserveConfigurationSelection" />
      <ComponentRef Id="PreserveDataSelection" />
      <ComponentRef Id="PrepareSetupSelection" />
    </Feature>
    <CustomAction Id="PrepareSetupState" FileRef="ClientExe" ExeCommand="installer prepare-setup" Execute="commit" Impersonate="no" Return="check" />
    <InstallExecuteSequence>
      <Custom Action="PrepareSetupState" After="InstallFiles" Condition="NOT REMOVE~=&quot;ALL&quot;" />
    </InstallExecuteSequence>
    <!-- Pairing is an explicit post-install CLI action; MSI never opens an interactive wizard. -->
  </Package>
</Wix>
